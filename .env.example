# ── NextXR Digital Twin — configuration ───────────────────────────────
# Copy to .env and fill in. Nothing here is required for local dev — the
# defaults match docker-compose.yml.
#
# For AWS, see AWS_DEPLOYMENT.md (§5.2).

# ── Relational store: twins, change log, bundles, checkpoints, scenes ─
# ⚠ THE MOST IMPORTANT SETTING IN THIS FILE FOR ANY DEPLOY.
#
# Set this to the RDS MySQL 8 endpoint and all user-created relational state —
# the twin registry, the governance change log, identity/auth, published agent
# bundles, agent checkpoints, the BIM scene cache and the telemetry historian —
# lives in one managed, backed-up, multi-writer database.
#
# UNSET, the app falls back to SQLite files under nextxr-ontology/data/. That is
# the right default for local dev and needs no server, but it is NOT a deploy
# posture: SQLite over NFS/EFS is safe for exactly one writer, which is what
# used to pin the ECS service at desired count 1 (no scale-out, no rolling
# deploy). See AWS_DEPLOYMENT.md §7.
#
# Target is RDS MySQL 8 (not 5.7 / MariaDB — the historian uses window functions).
# Enable TLS against RDS with NXR_DB_SSL_CA (the RDS CA bundle) or NXR_DB_SSL=1;
# without it the driver connects unencrypted.
# NXR_DATABASE_URL=mysql://nextxr:PASSWORD@twin.xxxx.eu-west-1.rds.amazonaws.com:3306/nextxr
#
# Local MySQL (docker compose up -d mysql) if you want to exercise the real
# dialect before deploying:
# NXR_DATABASE_URL=mysql://nextxr:nextxr2026@localhost:3306/nextxr
#
# Per-TASK connection pool bounds. The server-side total is (tasks × max), and
# RDS Proxy multiplexes on top of that — raise max only with the instance's
# max_connections in hand.
# NXR_DB_POOL_MIN=1
# NXR_DB_POOL_MAX=10
# NXR_DB_CONNECT_TIMEOUT=10
# NXR_DB_SSL_CA=/etc/ssl/certs/rds-combined-ca-bundle.pem  # verify RDS TLS
# NXR_DB_SSL=1                  # TLS without CA pinning (alternative to the above)
#
# Provision / inspect the schema, and apply ordered schema changes:
#   python -m db.schema            python -m db.schema --check
#   python -m db.migrations        python -m db.migrations --status

# ── Blob store: generated GLBs + 3-D job artifacts ────────────────────
# Set this to an S3 bucket and every generated model is written there instead of
# the task's local disk.
#
# UNSET, blobs go to nextxr-ontology/data/blobs/ — correct offline, and a real
# bug on a deploy with more than one task: the task that ran the reconstruction
# has the GLB, and the other tasks return 404 for a model the user just watched
# being generated.
# NXR_S3_BUCKET=nextxr-twin-blobs
# NXR_S3_PREFIX=prod             # optional: share one bucket across environments
#
# Local MinIO (docker compose up -d minio) to exercise the real S3 code path:
# NXR_S3_BUCKET=nextxr-blobs
# NXR_S3_ENDPOINT_URL=http://localhost:9000
# NXR_S3_ADDRESSING_STYLE=path   # MinIO does not do virtual-host style
# AWS_ACCESS_KEY_ID=nextxr
# AWS_SECRET_ACCESS_KEY=nextxr2026
# AWS_REGION=us-east-1
#
# On ECS use the TASK ROLE for S3 access — no keys in the environment.

# ── Event bus ─────────────────────────────────────────────────────────
# Redis Streams, one stream per tenant. Falls back to an IN-MEMORY bus when
# unreachable, which is correct for one process and silently wrong for two:
# each task would publish only to itself, so live updates stop for whichever
# users the load balancer sent to the other task. Nothing errors.
REDIS_URL=redis://localhost:6379/0
# NXR_REDIS_URL=redis://nextxr-twin.xxxx.cache.amazonaws.com:6379/0

# ── Telemetry historian ───────────────────────────────────────────────
# Where measurements live: one plain table on the SAME MySQL as above — same
# NXR_DATABASE_URL, same connection pool, same backup story. Rollups (1m/1h/1d)
# are computed on the fly from raw. There is no columnar compression and no
# database-enforced retention, so raw telemetry grows without bound; fine for an
# MVP / moderate ingest, add an app-level purge for high volume.
#
# Provision it once per environment (idempotent, safe to re-run):
#     python -m tools.historian_provision            # create the table
#     python -m tools.historian_provision --check    # report, change nothing
#
# Make the historian mandatory (fail boot if unreachable):
# NXR_REQUIRE_HISTORIAN=1
#
# Informational retention hints per tier, in days (read by an app-level purge if
# you add one; NOT enforced by the database). "none" means keep forever.
# NXR_HISTORIAN_RETENTION_RAW=30
# NXR_HISTORIAN_RETENTION_1M=400
# NXR_HISTORIAN_RETENTION_1H=1095
# NXR_HISTORIAN_RETENTION_1D=none

# ── Ingest ────────────────────────────────────────────────────────────
# Should ingested telemetry drive the behaviour registry (findings, diagnosis,
# the change log)? Default ON — this is what makes real data mean something
# rather than just accumulate. Turn it off to load history without firing rules,
# e.g. during a large backfill of data that is already known to be old.
# NXR_INGEST_BEHAVIOURS=1
#
# Devices authenticate with X-Device-Token, NOT with an API key — a gateway in a
# plant room must not hold a credential that reads every asset and bills the LLM
# endpoints. Register one with POST /api/v1/ingest/devices; the token is returned
# once and is not recoverable. There is nothing to configure here.

# ── Production posture: refuse to start on a per-task fallback ────────
# Each of these turns "silently degraded" into "fails loudly at boot". Set all
# four for any deploy with more than one task — they are the difference between
# a misconfiguration you find in CloudWatch in 30 seconds and one you find from
# a user saying the model sometimes disappears.
# NXR_REQUIRE_DB=1         # NXR_DATABASE_URL must be set (MySQL) and reachable
# NXR_REQUIRE_S3=1         # NXR_S3_BUCKET must be set, readable AND writable
# NXR_REQUIRE_REDIS=1      # a real Redis connection, not the in-memory fallback
# NXR_REQUIRE_HISTORIAN=1  # the historian must be reachable

# ── Where this service keeps its FILE state ───────────────────────────
# With NXR_S3_BUCKET set, this is only a scratch/working directory and no longer
# needs to survive a task replacement. Without it, it holds the blobs, and an
# ephemeral in-image path means every generated model is lost on redeploy.
# NXR_DATA_DIR=/data
#
# The 3-D reconstruction platform (object-photo → GLB) uses its OWN data dir for
# its working files. The Dockerfile sets this to /data/threed; set it here only
# when running the 3-D platform locally.
# DATA_DIR=/data/threed

# ── Graph database (required for writes) ──────────────────────────────
# Without Neo4j the app still loads and reads return empty with "degraded" — but
# creating twins/assets FAILS. Don't call a deploy done while degraded.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nextxr2026

# ── Server ────────────────────────────────────────────────────────────
PORT=8080

# ══ IDENTITY AND AUTHENTICATION ═══════════════════════════════════════
#
# THE API DEFAULTS TO CLOSED. This is the most important line in this file.
#
# It did not used to. `server/auth.py` served any request without a credential
# whenever NXR_API_KEYS was unset, so a deployment that forgot one variable was
# open to the internet — including the /copilot endpoints that bill our Anthropic
# key. There was a loud warning at boot, and a warning is not a control.
#
# So: authentication is REQUIRED unless something explicitly turns it off.
#
#   (nothing set)        REQUIRED   ← the default
#   NXR_DEV_MODE=1       off        the local escape hatch; start.ps1 sets it
#   NXR_REQUIRE_AUTH=0   off        explicit, greppable, for an air-gapped demo
#   NXR_REQUIRE_AUTH=1   required   explicit
#
# NXR_REQUIRE_AUTH=1

# ── Users, organisations and sessions ─────────────────────────────────
#
# The primary credential is now a USER ACCOUNT, not an environment variable.
# People sign in at /login; machines use API keys issued from the UI (Account →
# API keys) or `POST /api/v1/auth/orgs/{org}/keys`. Both are rows in the
# database, so revoking one is immediate and does not require a redeploy.
#
# A user reaches a tenant only through a membership in the ORGANISATION that owns
# it (`org_tenants`) — which is what lets one person belong to two customers
# without either seeing the other's data.

# REQUIRED IN PRODUCTION. Signs the access tokens. Unset, each task generates its
# own random key at startup — so a token minted by one task is rejected by every
# other, and the symptom is intermittent 401s under a load balancer that read as
# a client bug. The app REFUSES TO BOOT on that combination rather than let you
# find out in production. 32+ random bytes, from Secrets Manager.
#   openssl rand -base64 48
# NXR_JWT_SECRET=

# Server-side pepper for API-key and refresh-token hashes, so a stolen database
# dump alone cannot be matched against tokens found elsewhere. Optional.
# ⚠ ROTATING THIS INVALIDATES EVERY ISSUED API KEY AND EVERY SESSION.
# NXR_SECRET_PEPPER=

# Token lifetimes. The access token is stateless (fast to verify, cannot be
# revoked early — hence short); the refresh token is a database row (revocable,
# hence long). Defaults: 900s / 30d.
# NXR_ACCESS_TTL=900
# NXR_REFRESH_TTL=2592000

# Self-service signup. Defaults to OPEN only when auth is disabled, i.e. local
# dev — a public deployment does not gain signup by nobody setting the flag.
# Most B2B deployments want this off and provision through invitations.
# NXR_ALLOW_SIGNUP=0

# Require a confirmed email before first sign-in. Opt-in, because it is only
# meaningful with a mailer configured — turning it on without one creates
# accounts nobody can activate.
# NXR_REQUIRE_EMAIL_VERIFICATION=0

# Set to send reset and invitation links by email. Without it the API RETURNS the
# token in the response so the flow is completable offline — convenient locally,
# and not something you want in production.
# NXR_MAIL_FROM=noreply@example.com

# Mark the refresh cookie Secure. Defaults to on whenever auth is enforced; set 0
# only for plain-HTTP local testing (a Secure cookie is never sent over http://,
# so login appears to work and then fails to refresh).
# NXR_COOKIE_SECURE=1

# ── First administrator ───────────────────────────────────────────────
#
# The chicken-and-egg: on a fresh database there is nobody who can create the
# first account. These create one platform admin, ONCE.
#
# Idempotent twice over: skipped if the email already exists, and refused
# entirely once ANY user exists unless NXR_BOOTSTRAP_FORCE=1 — so a variable left
# in a task definition is not a standing "create an admin" instruction.
# ⚠ REMOVE BOTH FROM THE TASK DEFINITION AFTER THE FIRST DEPLOY.
# NXR_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# NXR_BOOTSTRAP_ADMIN_PASSWORD=
# NXR_BOOTSTRAP_ORG=NextXR

# ── Legacy environment keys ───────────────────────────────────────────
#
# STILL SUPPORTED, no longer primary. This is how the platform was configured
# before accounts existed; it remains the break-glass credential when the
# identity tables are unreachable, and it is what the test suite uses.
#
# There is NO default key any more. The image previously shipped with
# `nxr-demo-key` as a working ADMIN credential whenever this was unset, so anyone
# who read the source had root on any deployment that forgot to configure keys.
#
# NXR_API_KEYS=[{"key":"...","tenant":"*","role":"admin","name":"prod"}]
#
# SCOPING. Four forms, most specific first. Prefer anything over "*": an admin
# key reaches EVERY tenant, so handing one to a customer hands them every other
# customer's data.
#
#   {"tenant":"*"}                    admin — all tenants
#   {"tenants":["acme","acme-2"]}     an explicit set
#   {"tenant_prefix":"acme-"}         every tenant id under a prefix
#   {"tenant":"acme"}                 exactly one tenant
#
# Database-backed keys need none of this: their reach is the set of tenants their
# ORGANISATION owns, resolved live, so a twin created tomorrow is reachable by a
# key issued today without editing anything.
#
# Enforcement covers the tenant wherever it appears — path, query string or
# request body — on every /api route (server/tenancy.py). It previously covered
# only the query string, so /twins/{tenant}/... and every {"tenant": ...} body
# went unchecked.

# Skip the identity tables entirely and run on env keys alone. For a deployment
# that has not provisioned the schema yet.
# NXR_IDENTITY_DISABLED=0

# ── Transport security ────────────────────────────────────────────────
#
# CORS. Defaults: "*" when auth is disabled (local dev), and SAME-ORIGIN ONLY
# when it is enforced. The container serves the SPA and the API together, so the
# secure default needs no configuration — set this only for a separately-hosted
# frontend (CloudFront).
# NXR_CORS_ORIGINS=https://app.example.com,https://hub.example.com

# Behind a TLS-terminating load balancer, set BOTH. NXR_TRUST_PROXY makes the app
# read X-Forwarded-For for audit logs and rate-limit keys — WRONG without a proxy
# in front, since any client could then forge its own address and get a fresh
# rate-limit bucket per request.
# NXR_TRUST_PROXY=1
# NXR_HSTS=1

# Largest accepted request body. The 3-D endpoints take base64 images, so this is
# generous; it exists to stop an anonymous caller allocating unbounded memory.
# NXR_MAX_BODY_BYTES=33554432

# ── Rate limiting ─────────────────────────────────────────────────────
#
# On by default. Bounds three things that were previously unbounded: password
# guessing against /auth/login, the Anthropic bill on /copilot, and general abuse.
#
# Shared across tasks when NXR_REDIS_URL is set; otherwise each task counts
# separately and the real fleet-wide limit is N x the configured value (the boot
# log says which).
# NXR_RATELIMIT_DISABLED=0
# NXR_RATELIMIT_SCALE=1

# ── Logging ───────────────────────────────────────────────────────────
#
# JSON to stdout when auth is enforced, human-readable text otherwise. Every line
# carries the request id, so one API call's path through auth, tenancy, the graph
# and the physics runtime is one query in CloudWatch Logs Insights.
# NXR_LOG_JSON=1
# NXR_LOG_LEVEL=INFO

# ── Migrations ────────────────────────────────────────────────────────
#
# OFF by default, and the default is the recommendation: several tasks starting
# together queue on the advisory lock, and the ones that wait fail their health
# check. Run them as a one-off task before the service rolls —
# `python -m db.migrations`. There is no deploy pipeline that does this for you;
# it is a manual step in the runbook (AWS_DEPLOYMENT.md §14).
# NXR_AUTO_MIGRATE=0

# ── LLM (twin narration / agent flows) ────────────────────────────────
# ANTHROPIC_API_KEY powers the EMBEDDED AGENT LAYER (copilot/) — diagnosis,
# work orders, incident reports, repair procedures, narration, and the
# dashboard/mechanic chats. These agents run in-process against the machine-twin
# runtime, so they read the same live physics state the 3-D scene does.
#
# Without a key nothing breaks: every agent falls back to a deterministic stub
# and the response's `ai.backend` field reports "stub" so you can tell. Check
# which mode you're in at GET /api/v1/copilot/health.
# ANTHROPIC_API_KEY=
# NXR_CLAUDE_MODEL=claude-sonnet-5    # override the model (opus: claude-opus-4-8)
# NXR_COPILOT_EFFORT=high             # low|medium|high|xhigh|max for deep agents
#
# ── Claude spend controls (copilot/spend.py) ──────────────────────────
# What this costs is reported on GET /api/v1/copilot/health under `spend`:
# running cost, tokens, per-agent ranking, prompt-cache hit rate, and the
# share of requests answered without an API call at all.
#
# BUDGET CAP. Unset = no cap. Set these on any deployment whose API is
# reachable by people you do not control — copilot traffic bills to YOUR key,
# and this is the only thing that bounds it. Past the cap agents fall back to
# their deterministic stubs (same as running keyless): the page keeps working,
# it just stops billing.
# NXR_COPILOT_BUDGET_TOTAL_USD=25     # ceiling for the whole process
# NXR_COPILOT_BUDGET_USD=1            # per-tenant ceiling
#
# RESPONSE CACHE. On by default: a byte-identical request inside the TTL is
# answered from memory, and identical concurrent requests are coalesced into
# one API call. Live telemetry is part of the prompt, so a twin that has moved
# always produces a fresh answer — the cache cannot serve a stale reading.
# NXR_COPILOT_CACHE_OFF=1             # disable (e.g. to demo that it is live)
# NXR_COPILOT_CACHE_TTL=120           # seconds
# NXR_COPILOT_CACHE_MAX=256           # entries
#
# The agent graphs (Build-a-Twin, Bundle Author, plan-image parsing) share the SAME
# Claude key and model policy via agents/gateway.py → copilot.config — the platform
# is Claude-only now (the earlier OpenAI path was retired). NXR_LLM_MAX_CALLS caps
# gateway calls per session.
# NXR_LLM_MAX_CALLS=100
