# ── NextXR Digital Twin — configuration ───────────────────────────────
# Copy to .env and fill in. Nothing here is required for local dev — the
# defaults match docker-compose.yml.
#
# For AWS, see AWS_DEPLOYMENT.md (§5.2).

# ── Relational store: twins, change log, bundles, checkpoints, scenes ─
# ⚠ THE MOST IMPORTANT SETTING IN THIS FILE FOR ANY DEPLOY.
#
# Set this to the RDS PostgreSQL 16 endpoint and all user-created relational
# state — the twin registry, the governance change log, published agent
# bundles, agent checkpoints and the BIM scene cache — lives in one managed,
# backed-up, multi-writer database.
#
# UNSET, the app falls back to SQLite files under nextxr-ontology/data/. That is
# the right default for local dev and needs no server, but it is NOT a deploy
# posture: SQLite over NFS/EFS is safe for exactly one writer, which is what
# used to pin the ECS service at desired count 1 (no scale-out, no rolling
# deploy). See AWS_DEPLOYMENT.md §7.
#
# sslmode=require is not optional against RDS — without it the driver will
# happily fall back to an unencrypted connection.
# NXR_DATABASE_URL=postgresql://nextxr:PASSWORD@twin.xxxx.eu-west-1.rds.amazonaws.com:5432/nextxr?sslmode=require
#
# Local Postgres (docker compose up -d postgres) if you want to exercise the
# real dialect before deploying:
# NXR_DATABASE_URL=postgresql://nextxr:nextxr2026@localhost:5432/nextxr
#
# Per-TASK connection pool bounds. The server-side total is (tasks × max), and
# RDS Proxy multiplexes on top of that — raise max only with the instance's
# max_connections in hand.
# NXR_DB_POOL_MIN=1
# NXR_DB_POOL_MAX=10
# NXR_DB_CONNECT_TIMEOUT=10
# NXR_DB_SSLMODE=require        # alternative to putting sslmode in the URL
# NXR_DB_APP_NAME=nextxr-twin   # shows up in pg_stat_activity / Perf Insights
#
# Provision / inspect the schema:
#   python -m db.schema            python -m db.schema --check
# Move an existing SQLite deployment in:
#   python -m db.migrate --dry-run     then     python -m db.migrate

# ── Blob store: generated GLBs + 3-D job artifacts ────────────────────
# Set this to an S3 bucket and every generated model is written there instead of
# the task's local disk.
#
# UNSET, blobs go to nextxr-ontology/data/blobs/ — correct offline, and a real
# bug on a deploy with more than one task: the task that ran the reconstruction
# has the GLB, and the other tasks return 404 for a model the user just watched
# being generated.
# NXR_S3_BUCKET=nextxr-twin-blobs
# NXR_S3_PREFIX=prod             # optional: share one bucket across environments
#
# Local MinIO (docker compose up -d minio) to exercise the real S3 code path:
# NXR_S3_BUCKET=nextxr-blobs
# NXR_S3_ENDPOINT_URL=http://localhost:9000
# NXR_S3_ADDRESSING_STYLE=path   # MinIO does not do virtual-host style
# AWS_ACCESS_KEY_ID=nextxr
# AWS_SECRET_ACCESS_KEY=nextxr2026
# AWS_REGION=us-east-1
#
# On ECS use the TASK ROLE for S3 access — no keys in the environment.

# ── Event bus ─────────────────────────────────────────────────────────
# Redis Streams, one stream per tenant. Falls back to an IN-MEMORY bus when
# unreachable, which is correct for one process and silently wrong for two:
# each task would publish only to itself, so live updates stop for whichever
# users the load balancer sent to the other task. Nothing errors.
REDIS_URL=redis://localhost:6379/0
# NXR_REDIS_URL=redis://nextxr-twin.xxxx.cache.amazonaws.com:6379/0

# ── Telemetry historian (TimescaleDB) ─────────────────────────────────
# Where measurements live. It is an EXTENSION on the Postgres above, not a second
# database — same NXR_DATABASE_URL, same connection pool, same backup story. What
# the extension adds is the part that makes telemetry affordable: time
# partitioning, incrementally-maintained 1m/1h/1d rollups, 10-20x compression,
# and retention policies.
#
# Provision it once per environment (idempotent, safe to re-run):
#     python -m tools.historian_provision --extension   # needs rds_superuser
#     python -m tools.historian_provision --check       # report, change nothing
#
# WITHOUT the extension the historian still works — and never compresses and
# never expires anything, so the disk fills and trend queries scan raw rows.
# NXR_REQUIRE_TIMESCALE=1
#
# Retention per tier, in days. Override for a regulatory retention floor.
# "none" keeps a tier forever (the default for the daily rollup).
# NXR_HISTORIAN_RETENTION_RAW=30
# NXR_HISTORIAN_RETENTION_1M=400
# NXR_HISTORIAN_RETENTION_1H=1095
# NXR_HISTORIAN_RETENTION_1D=none

# ── Ingest ────────────────────────────────────────────────────────────
# Should ingested telemetry drive the behaviour registry (findings, diagnosis,
# the change log)? Default ON — this is what makes real data mean something
# rather than just accumulate. Turn it off to load history without firing rules,
# e.g. during a large backfill of data that is already known to be old.
# NXR_INGEST_BEHAVIOURS=1
#
# Devices authenticate with X-Device-Token, NOT with an API key — a gateway in a
# plant room must not hold a credential that reads every asset and bills the LLM
# endpoints. Register one with POST /api/v1/ingest/devices; the token is returned
# once and is not recoverable. There is nothing to configure here.

# ── Production posture: refuse to start on a per-task fallback ────────
# Each of these turns "silently degraded" into "fails loudly at boot". Set all
# four for any deploy with more than one task — they are the difference between
# a misconfiguration you find in CloudWatch in 30 seconds and one you find from
# a user saying the model sometimes disappears.
# NXR_REQUIRE_DB=1         # NXR_DATABASE_URL must be set and reachable
# NXR_REQUIRE_S3=1         # NXR_S3_BUCKET must be set, readable AND writable
# NXR_REQUIRE_REDIS=1      # a real Redis connection, not the in-memory fallback
# NXR_REQUIRE_TIMESCALE=1  # the historian must be a hypertable, not a plain table

# ── Where this service keeps its FILE state ───────────────────────────
# With NXR_S3_BUCKET set, this is only a scratch/working directory and no longer
# needs to survive a task replacement. Without it, it holds the blobs, and an
# ephemeral in-image path means every generated model is lost on redeploy.
# NXR_DATA_DIR=/data
#
# The 3-D reconstruction platform (object-photo → GLB) uses its OWN data dir for
# its working files. The Dockerfile sets this to /data/threed; set it here only
# when running the 3-D platform locally.
# DATA_DIR=/data/threed

# ── Graph database (required for writes) ──────────────────────────────
# Without Neo4j the app still loads and reads return empty with "degraded" — but
# creating twins/assets FAILS. Don't call a deploy done while degraded.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nextxr2026

# ── Server ────────────────────────────────────────────────────────────
PORT=8080

# ── Auth ──────────────────────────────────────────────────────────────
# Dev-permissive by default. If set (JSON array of {key,tenant,role,name}), callers
# must send a matching X-API-Key — and the hub's TWIN_API_KEY must be one of them.
# ⚠ REQUIRED before exposing the service publicly: while this is unset the API is
# OPEN — every /api call, including the LLM-billing /copilot endpoints, is served
# keyless. See AWS_DEPLOYMENT.md §10.
# NXR_API_KEYS=[{"key":"...","tenant":"*","role":"admin","name":"prod"}]
#
# SCOPING A KEY. There are four forms, most specific first. Prefer anything over
# "*": an admin key reaches EVERY tenant, so handing one to a customer hands them
# every other customer's data.
#
#   {"tenant":"*"}                    admin — all tenants
#   {"tenants":["acme","acme-2"]}     an explicit set
#   {"tenant_prefix":"acme-"}         every tenant id under a prefix
#   {"tenant":"acme"}                 exactly one tenant
#
# `tenants` and `tenant_prefix` exist because a single-tenant field could not
# express "this customer owns 50 twins" without granting "*". A prefix-scoped key
# is also the only kind that can CREATE twins, since the new twin's id has to land
# inside the creator's own scope to remain readable.
#
# Enforcement covers the tenant wherever it appears — path, query string or
# request body — on every /api route (server/tenancy.py). It previously covered
# only the query string, so /twins/{tenant}/... and every {"tenant": ...} body
# went unchecked.
#
# Production posture: set NXR_REQUIRE_AUTH=1 to reject any keyless /api call even
# when NXR_API_KEYS is empty (closes the dev fail-open bypass). Leave unset locally.
# NXR_REQUIRE_AUTH=1
#
# CORS: defaults to "*" (local dev + the federated hub). Set a comma-separated
# allow-list to lock the API to known origins in production.
# NXR_CORS_ORIGINS=https://app.example.com,https://hub.example.com

# ── LLM (twin narration / agent flows) ────────────────────────────────
# ANTHROPIC_API_KEY powers the EMBEDDED AGENT LAYER (copilot/) — diagnosis,
# work orders, incident reports, repair procedures, narration, and the
# dashboard/mechanic chats. These agents run in-process against the machine-twin
# runtime, so they read the same live physics state the 3-D scene does.
#
# Without a key nothing breaks: every agent falls back to a deterministic stub
# and the response's `ai.backend` field reports "stub" so you can tell. Check
# which mode you're in at GET /api/v1/copilot/health.
# ANTHROPIC_API_KEY=
# NXR_CLAUDE_MODEL=claude-sonnet-5    # override the model (opus: claude-opus-4-8)
# NXR_COPILOT_EFFORT=high             # low|medium|high|xhigh|max for deep agents
#
# ── Claude spend controls (copilot/spend.py) ──────────────────────────
# What this costs is reported on GET /api/v1/copilot/health under `spend`:
# running cost, tokens, per-agent ranking, prompt-cache hit rate, and the
# share of requests answered without an API call at all.
#
# BUDGET CAP. Unset = no cap. Set these on any deployment whose API is
# reachable by people you do not control — copilot traffic bills to YOUR key,
# and this is the only thing that bounds it. Past the cap agents fall back to
# their deterministic stubs (same as running keyless): the page keeps working,
# it just stops billing.
# NXR_COPILOT_BUDGET_TOTAL_USD=25     # ceiling for the whole process
# NXR_COPILOT_BUDGET_USD=1            # per-tenant ceiling
#
# RESPONSE CACHE. On by default: a byte-identical request inside the TTL is
# answered from memory, and identical concurrent requests are coalesced into
# one API call. Live telemetry is part of the prompt, so a twin that has moved
# always produces a fresh answer — the cache cannot serve a stale reading.
# NXR_COPILOT_CACHE_OFF=1             # disable (e.g. to demo that it is live)
# NXR_COPILOT_CACHE_TTL=120           # seconds
# NXR_COPILOT_CACHE_MAX=256           # entries
#
# The agent graphs (Build-a-Twin, Bundle Author, plan-image parsing) share the SAME
# Claude key and model policy via agents/gateway.py → copilot.config — the platform
# is Claude-only now (the earlier OpenAI path was retired). NXR_LLM_MAX_CALLS caps
# gateway calls per session.
# NXR_LLM_MAX_CALLS=100
