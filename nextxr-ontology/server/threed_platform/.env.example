# Copy to .env and fill in. The platform runs end-to-end without keys (TRELLIS
# falls back to a clearly-marked stub mesh); set the RunPod vars for real models.

# ── TRELLIS reconstruction (Stage 9) — first configured provider wins ─────────
# Preferred: RunPod serverless endpoint. Build your handler to the request/response
# contract documented in app/stages/reconstruct.py and README.md.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Alternative: a generic TRELLIS HTTP server (e.g. a RunPod *pod*) honouring the
# same contract; receives the `input` object and returns {glb_base64|glb_url} or raw .glb.
TRELLIS_HTTP_URL=
# Alternative: Replicate model:version.
REPLICATE_API_TOKEN=
TRELLIS_REPLICATE_MODEL=

# ── Object pipeline profile ──────────────────────────────────────────────────
# "faithful" (default) = the authors' own example.py, for WHICHEVER TRELLIS is
#   deployed. The original photo goes straight to the model so the model's own
#   preprocessing runs, and the model's own post-processing produces the GLB.
#     TRELLIS 1  → run(image, seed=1) · to_glb(simplify=0.95, texture_size=1024)
#     TRELLIS.2  → run(...) · mesh.simplify(2**24) · to_glb(remesh, PBR)
#   Works against the v1 endpoint you already have — no redeploy needed.
# "legacy" = our original 13-stage spine (our rembg + sharpen/autocontrast before
#   the model, our repair/LOD/UV after it). Correct for raw scan geometry.
# "auto" = legacy on v1, faithful on v2.
PIPELINE_PROFILE=faithful

# ── Which TRELLIS the deployed worker runs ───────────────────────────────────
# "2" = TRELLIS.2 (apps/trellis2-worker, microsoft/TRELLIS.2-4B) — best quality
# "1" = TRELLIS 1 (apps/trellis-worker, microsoft/TRELLIS-image-large)
# "both" = send both parameter sets; each worker reads its own (default, safe
#          while migrating an endpoint). Set to "2" once the v2 image is live.
TRELLIS_VARIANT=both

# Texture resolution requested. Upstream app.py defaults to 2048; their
# showcase example.py uses 4096. Max 4096. NOTE: the worker returns the GLB as
# base64 inside the job result, so 4096 + a 1M-face decimation target can push
# the response past RunPod's payload limit — raise these together and check that
# a job actually round-trips before making it the default.
TRELLIS_TEXTURE_SIZE=2048
# Patience for one job before this attempt gives up (the job id is recorded, so
# a re-run collects the result rather than paying for it twice).
TRELLIS_WAIT_SECONDS=900

# ── TRELLIS.2 only ───────────────────────────────────────────────────────────
# Voxel grid resolution — the main quality/cost dial.
# 512 (~3s on H100) | 1024 (~17s) | 1536 (~60s, maximum fidelity)
TRELLIS2_RESOLUTION=1024
# Target face count for upstream's decimation. app.py defaults to 500000;
# example.py uses 1000000 (the max).
TRELLIS2_DECIMATION_TARGET=500000
# Export textures as WebP (upstream default; three.js reads EXT_texture_webp).
TRELLIS2_WEBP=1

# ── Geometry Prior Retrieval (Stage 8) ───────────────────────────────────────
PRIOR_ENABLED=1
# similarity ≥ this AND the match has a canonical mesh → reuse it (max consistency)
PRIOR_RETRIEVE_THRESHOLD=0.92
# similarity ≥ this → pass the matched asset label to TRELLIS as a hint
PRIOR_HINT_THRESHOLD=0.55

# ── Drawing route (datacenter / hospital plans) reuses the 2d-to-3d parser ────
# If that service is running, set its base URL; else the parser is imported in-process.
TWO_D_TO_3D_URL=

# ── Storage ───────────────────────────────────────────────────────────────────
# Leave unset to use this folder's own data/ regardless of the server's cwd.
DATA_DIR=
