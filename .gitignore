__pycache__/
*.pyc
.env
*.egg-info/
dist/
build/
.DS_Store
neo4j_data/
data/
node_modules/

# Runtime-authored capability bundles (produced by the Bundle Author agent).
# These are demo artifacts, not source — regenerated by running the agents.
nextxr-ontology/packs/published/

# Terraform. State holds every generated credential in plaintext (RDS and Redis
# passwords, the JWT signing key) and `.tfvars` holds environment configuration —
# neither belongs in git. State lives in the S3 backend; `.tfvars.example` files
# ARE tracked, as the documented template.
infra/terraform/**/.terraform/
infra/terraform/**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json

# apps/ — the 2-D→3-D + 3-D generation workspaces, merged into this repo.
# node_modules (reinstall via npm install), build output (dist/) and runtime
# job/data outputs are all ignored above; source is tracked.
apps/**/node_modules/
apps/3d-platform/data/
