__pycache__/
*.pyc
.env
*.egg-info/
dist/
build/
.DS_Store
neo4j_data/
# Runtime records and blobs - the SQLite fallback DBs, generated GLBs, scene
# JSON and 3-D job artifacts that paths.py writes under nextxr-ontology/data
# at runtime (DATA_DIR, overridable with NXR_DATA_DIR). None of it is source.
#
# ANCHORED TO THAT ONE PATH (leading `/`) ON PURPOSE. A bare `data/` matches a
# directory named `data` at ANY depth, and it silently swallowed
# frontend/src/panels/hospitalFloorPlan/data/ - floorPlan.js and
# assetPlacements.js, which seven modules in that panel import. Nothing warned:
# `git add` skips an ignored path without a word, so the two files were never
# committed and a clean clone could not build at all -
#
#     Could not resolve "./data/floorPlan"
#       from "src/panels/hospitalFloorPlan/HospitalFloorPlanScene.jsx"
#
# which took down `npm run build`, `docker build .` and the CI Frontend job.
# Do not remove the leading slash. The 3-D platform's own runtime dir is
# ignored by nextxr-ontology/server/threed_platform/.gitignore, likewise
# anchored, and apps/3d-platform/data/ by the anchored rule further down.
/nextxr-ontology/data/
node_modules/

# Runtime-authored capability bundles (produced by the Bundle Author agent).
# These are demo artifacts, not source — regenerated by running the agents.
nextxr-ontology/packs/published/

# Coverage output. The unit job runs `pytest --cov`, which drops `.coverage`
# (a binary SQLite file) and `coverage.xml` in the repository root. CI uploads
# the XML as an artifact; neither should ever be committed.
.coverage
.coverage.*
coverage.xml
htmlcov/

# apps/ — the 2-D→3-D + 3-D generation workspaces, merged into this repo.
# node_modules (reinstall via npm install), build output (dist/) and runtime
# job/data outputs are all ignored above; source is tracked.
apps/**/node_modules/
apps/3d-platform/data/

# ── Root-level presentation & planning documents ─────────────────────────
# Slide decks, feature lists and planning notes. None of them is source, all
# of them go stale the moment the code moves, and together they are what a
# reader has to wade through to find the one document that is a contract.
#
# AWS_DEPLOYMENT.md is that document and is deliberately kept.
#
# ANCHORED TO THE ROOT (leading `/`) ON PURPOSE. A bare `*.md`/`*.html` would
# also swallow every nested README.md and — far worse — the three real
# application entrypoints: frontend/index.html, apps/2d-to-3d/frontend/index.html
# and nextxr-ontology/server/threed_platform/web/index.html. Those are build
# inputs, not documents. Do not remove the leading slash.
/*.html
/*.md
/*.docx
/*.pptx
/*.pdf
/logo*.png
!/AWS_DEPLOYMENT.md
!/README.md

# docs/ — the generated document set (DRD/FRD/HLD/LLD as .docx, the TechDocs
# HTML + PNG diagrams, the OpenAPI dump, a schema.sql snapshot) and the
# `gen_*.py` scripts that produce it. Excluded wholesale by request.
#
# The generated files are output and were always going to drift from the code
# they describe. THE GENERATORS ARE NOT — `docs/gen_*.py` is the only copy of
# how that document set is built, so it now lives outside version control on
# the author's machine. If a document set is ever needed again, unignore
# `!docs/gen_*.py` first; nothing else in here is authoritative (the API
# contract is FastAPI's live /openapi.json, the schema is db/schema.py).
docs/

# Project-local Python environment (see start.ps1 — the pinned stack is kept
# out of the shared machine-wide interpreter).
.venv/
